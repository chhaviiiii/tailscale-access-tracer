TS_API_TOKEN=PASTE_YOUR_TOKEN_ON_THIS_LINE_ONLY

# Everything below this line: leave as is. Do not paste the token below here.

# "-" means "my own default tailnet" — almost always correct.
TS_TAILNET=-

# Optional: which identity to run the /acl/preview check for.
# Defaults to the first device's owner if left blank. Not a token field.
TS_PREVIEW_USER=
